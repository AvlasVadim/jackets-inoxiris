# Copy to .env.local (never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
# Forum topic «Отправка товара»: approved orders get a new card here (photo+caption,
# no who-approved stamp) with shipping status buttons. Same numeric chat as CHAT_ID.
# Example: 60
TELEGRAM_SHIPPING_THREAD_ID=
# Comma-separated Telegram user ids allowed to Approve/Reject orders (ord:ok / ord:no)
# and to press shipping status buttons (ship:*). Empty/unset = deny all presses
# (prod stays locked until ids are set). Same rule for Vercel webhook and local
# getUpdates polling. Get your numeric id via @userinfobot.
# Example: 123456789,987654321
TELEGRAM_APPROVER_IDS=
# Optional: protect POST /api/telegram/webhook (X-Telegram-Bot-Api-Secret-Token).
# Local/preview uses getUpdates polling by default — no public URL needed.
# On Vercel prod, Telegram must setWebhook to:
#   https://jackets-inoxiris.vercel.app/api/telegram/webhook
# Register/verify (token only in your shell / Vercel env — never commit):
#   TELEGRAM_BOT_TOKEN=… node scripts/set-telegram-webhook.mjs
#   TELEGRAM_BOT_TOKEN=… node scripts/set-telegram-webhook.mjs --info
TELEGRAM_WEBHOOK_SECRET=
# Optional override for the setWebhook script (defaults to jackets-inoxiris prod URL).
# TELEGRAM_WEBHOOK_URL=https://jackets-inoxiris.vercel.app/api/telegram/webhook
# Optional on Vercel: canonical public origin for product photos
# (do NOT use ephemeral VERCEL_URL — Telegram may get SSO/Dashboard HTML).
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then https://jackets-inoxiris.vercel.app
# Example: https://jackets-inoxiris.vercel.app
PUBLIC_SITE_URL=
