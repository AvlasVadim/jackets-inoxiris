# Copy to .env.local (never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
# Comma-separated Telegram user ids allowed to Approve/Reject orders (ord:ok / ord:no).
# Empty/unset = deny all presses (prod stays locked until ids are set). Same rule for
# Vercel webhook and local getUpdates polling. Get your numeric id via @userinfobot.
# Example: 123456789,987654321
TELEGRAM_APPROVER_IDS=
# Optional: protect POST /api/telegram/webhook (X-Telegram-Bot-Api-Secret-Token).
# Local/preview uses getUpdates polling by default — no public URL needed.
# On Vercel, setWebhook to https://<domain>/api/telegram/webhook instead of polling.
TELEGRAM_WEBHOOK_SECRET=
# Optional on Vercel: canonical public origin for product photos
# (do NOT use ephemeral VERCEL_URL — Telegram may get SSO/Dashboard HTML).
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then https://jackets-inoxiris.vercel.app
# Example: https://jackets-inoxiris.vercel.app
PUBLIC_SITE_URL=
